{
  "name": "seu-vendor/gnotas-api",
  "description": "API para emissão de notas fiscais utilizando NFePHP.",
  "type": "project",
  "require": {
    "php": "^8.4",
    "justinrainbow/json-schema": "^5.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "NFePHP\\Common\\": "src/Lib/sped-common/src/",
      "NFePHP\\NFe\\": "src/Lib/sped-nfe/src/",
      "NFePHP\\DA\\": "src/Lib/sped-da/src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}