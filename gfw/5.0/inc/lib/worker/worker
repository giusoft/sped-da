}


# Checa se está permitido o login via ssh com senha
function sshStatusPassword()
{
	echoDebug "...sshStatusPassword"
	echo -n "-sshStatusPassword: " >> $ARQ
	if (grep -v "#" /etc/ssh/sshd_config | grep "PasswordAuthentication yes") > /dev/null;then
		echo 1 >> $ARQ
	else
		echo 0 >> $ARQ
	fi
}

# Libera o login via ssh com senha
function sshEnablePassword()
{
	echoDebug "...sshEnablePassword"

	if [ ! -f /etc/ssh/sshd_config.bkp ];then
		cp -f /etc/ssh/sshd_config /etc/ssh/sshd_config.bkp
	fi
	grep -v "PasswordAuthentication" /etc/ssh/sshd_config > /tmp/ssh.tmp
	echo /tmp/ssh.tmp > /etc/ssh/sshd_config
	echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config
	rm -f /tmp/ssh.tmp
	servStop "sshd"
	servStart "sshd"
}

# Bloqueia o login via ssh com senha
function sshDisablePassword()
{
	echoDebug "...sshDisablePassword"

	if [ ! -f /etc/ssh/sshd_config.bkp ];then
		cp -f /etc/ssh/sshd_config /etc/ssh/sshd_config.bkp
	fi
	grep -v "PasswordAuthentication" /etc/ssh/sshd_config > /tmp/ssh.tmp
	echo /tmp/ssh.tmp > /etc/ssh/sshd_config
	echo "PasswordAuthentication no" >> /etc/ssh/sshd_config
	rm -f /tmp/ssh.tmp
	servStop "sshd"
	servStart "sshd"
}

# Executa comando
function run()
{
	echoDebug "SO: $SO"

	for CMD in $CMDS;do
		echoDebug "running: $CMD"

		P1=`echo $CMD|cut -d':' -f 1`
		P2=`echo $CMD|cut -d':' -f 2`
		P3=`echo $CMD|cut -d':' -f 3`
		P4=`echo $CMD|cut -d':' -f 4`
		P5=`echo $CMD|cut -d':' -f 5`

		#echoDebug "...P1=$P1 P2=$P2 P3=$P3 P4=$P4"

		case "$P1" in
			date)
				echoDebug "...date"
				echo -n "-Date: " >> $ARQ
				date "+%Y-%m-%d %H:%M:%S" >> $ARQ
				;;
			update)
				update
				;;
			debug)
				DEBUG=1
				;;
			cat)
				echoDebug "...cat"
				if [ "$P1" == "$P2" ];then
					cat $ARQ
				else
					cat $P2 >> $ARQ
				fi
				;;
			info)
				info
				;;
			dbinfo)
				dbinfo
				;;
			purge)
				purge
				;;
			httpdAccess)
				httpdAccess
				;;
			sshStatusPassword)
				sshStatusPassword
				;;
			sshEnablePassword)
				sshEnablePassword
				;;
			sshDisablePassword)
				sshDisablePassword
				;;
			servStart)
				servStart $P2
				;;
			servStop)
				servStop $P2
				;;
			servStatus)
				servStatus $P2
				;;
			reboot)
				reboot
				;;
			shutdown)
				shutdown -h now
				;;
			execute)
				echoDebug '...execute'
				$P2 $P3 $P4 $P5 >> $ARQ
				;;
			*)
				echo "cmd error: $CMD"
				exit 1
		esac
	done
}

# Verifica se há comando a executar
function checkRun()
{
	if [ "$ICMD" != "" ];then
		echo $ICMD | tr ',' "\n" > $FCMD
	fi
	if [ -f $FCMD ];then
		# Remove o arquivo de resultado para poder gerar um novo
		rm -f $ARQ
		CMDS=`cat $FCMD`
		run
		chmod 666 $ARQ
		# Apaga arquivo com lote de comandos
		rm -f $FCMD
	fi
}

if [ "$ICMD" == "-d" ];then
	# Roda como daemon
	echo "Modo Daemon"
	ICMD=""
	DAEMON=1
	DEBUG=1
	rm -f /tmp/wcmd
	while [ : ]
	do
		checkRun
		sleep 3
	done
else
	# Roda uma vez somente
	checkRun
fi
