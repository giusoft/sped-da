# Obtém dados do ambiente atual
function info()
{
	echoDebug "...info"
	# SISTEMA

	echo -n "-Hostname: " >> $ARQ
	hostname >> $ARQ

	# PROCESSADOR

	echo -n "-OS: " >> $ARQ
	if [ "$SO" == "macos" ];then
		# Mac
		echo -n "macOS " >> $ARQ 2>/dev/null
		sw_vers | cut -f 2 | head -n 2 | tail -n 1 >> $ARQ 2>/dev/null
		echo -n "-Processor: " >> $ARQ 2>/dev/null
		sysctl -n machdep.cpu.brand_string >> $ARQ 2>/dev/null
		echo -n "-Cores: " >> $ARQ
		sysctl -n machdep.cpu.core_count >> $ARQ 2>/dev/null
		echo -n "-Memory: " >> $ARQ
		sysctl -n hw.memsize >> $ARQ 2>/dev/null
		echo "-Disk:" >> $ARQ
		df -h | grep /dev/disk >> $ARQ 2>/dev/null
	else
		if [ "$SO" == "redhat" ];then
			# Redhat, Fedora, Centos
			head -n 1 /etc/redhat-release >> $ARQ 2>/dev/null
		else
			# Linux
			head -n 1 /etc/issue >> $ARQ 2>/dev/null
		fi

		echo "-Processor: `cat /proc/cpuinfo | grep "model name" | cut -f 2 -d: | head -n 1`" | sed 's/^[ \t]*//;s/[ \t]*$//' >> $ARQ 2>/dev/null
		echo "-Cores: `cat /proc/cpuinfo | grep "model name" | cut -f 2 -d: | wc -l`" | sed 's/^[ \t]*//;s/[ \t]*$//' >> $ARQ 2>/dev/null
		echo "-Bogomips: `cat /proc/cpuinfo | grep "bogomips" | cut -f 2 -d: | head -n 1 | sed 's/^[ \t]*//;s/[ \t]*$//'`" | sed 's/^[ \t]*//;s/[ \t]*$//' >> $ARQ 2>/dev/null
		echo "-Memory: `free | head -n 2 | tail -n 1 | cut -f 2 -d: | sed 's/^[ \t]*//;s/[ \t]*$//' | cut -f 1 -d" "`" | sed 's/^[ \t]*//;s/[ \t]*$//' >> $ARQ 2>/dev/null
		echo "-Disk:" >> $ARQ
		df -h | grep /dev/sd >> $ARQ 2>/dev/null
	fi


}

