function update()
{
	echoDebug "...update"
	su - sistemas
	cd /var/www/html/gfw
	git pull
	exit
}


function httpdAccess()
{
	echoDebug "...httpdAccess"
	if [ -f /var/www/html/_acessos-httpd.log ];then
		echo "-httpdAccess: " >> $ARQ
		cat /var/www/html/_acessos-httpd.log >> $ARQ
	fi
}

# Fornece status de algum serviço
function servStatus()
{
	echoDebug "...servStatus $1"
	PAR="$1"

	if [ "$SO" == "ubuntu" ];then
		if [ "$PAR" == "httpd" ];then
			PAR="apache2"
		fi
	fi

	if [ "$SO" == "ubuntu" ];then
		if [ -f /etc/init.d/$PAR ];then
			if /etc/init.d/$PAR status | grep "inactive" ;then
				echo "-servStatus $1: 0" >> $ARQ
			else
				echo "-servStatus $1: 1" >> $ARQ
			fi
		else
			echo "-servStatus $1: -" >> $ARQ
		fi
	else
		if service $PAR status | grep "parado" ;then
			echo "-servStatus $1: 0" >> $ARQ
		else
			echo "-servStatus $1: 1" >> $ARQ
		fi
	fi
}

# Para serviço
function servStop()
{
	echoDebug "...servStop $1"
	PAR="$1"

	if [ "$SO" == "ubuntu" ];then
		if [ "$PAR" == "httpd" ];then
			PAR="apache2"
		fi
	fi

	if [ "$SO" == "ubuntu" ];then
		if [ -f /etc/init.d/$PAR ];then
			if /etc/init.d/$PAR stop | grep " ok " ;then
				echo "-servStop $1: 1" >> $ARQ
			else
				echo "-servStop $1: 0" >> $ARQ
			fi
		else
			echo "-servStop $1: -" >> $ARQ
		fi
	else
		if service $PAR stop ;then
			echo "-servStop $1: 1" >> $ARQ
		else
			echo "-servStop $1: 0" >> $ARQ
		fi
	fi

}

# Inicia serviço
function servStart()
{
	echoDebug "...servStart $1"
	PAR="$1"

	if [ "$SO" == "ubuntu" ];then
		if [ "$PAR" == "httpd" ];then
			PAR="apache2"
		fi
	fi

	if [ "$SO" == "ubuntu" ];then
		if [ -f /etc/init.d/$PAR ];then
			if /etc/init.d/$PAR start | grep "ok" ;then
				echo "-servStart $1: 1" >> $ARQ
			else
				echo "-servStart $1: 0" >> $ARQ
			fi
		else
			echo "-servStart $1: -" >> $ARQ
		fi
	else
		if service $PAR start  ;then
			echo "-servStart $1: 1" >> $ARQ
		else
			echo "-servStart $1: 0" >> $ARQ
		fi
	fi

}

