#!/bin/bash

DEBUG=0
DAEMON=0
FCMD="/tmp/wcmd"
ICMD="$1"
HOJE=` date +"%Y-%m-%d" `
HORA=` date +"%H" `
ARQ="/tmp/worker.bin"
LOG="/var/log/wcmd.log"

SO="undefined"
if [ -f "/etc/redhat-release" ];then
	SO="redhat"
else
	if [ -f "/etc/issue" ];then
		SO=`cat /etc/issue | cut -f 1 -d" " | tr '[:upper:]' '[:lower:]'`
	else
		SO="macos"
	fi
fi


# Mensagens na tela
function echoDebug()
{
	if [ "$DAEMON" == 1 ];then
		echo `date +"%Y-%m-%d %H:%M:%S "` $1 >> $LOG
	else
		if [ "$DEBUG" == 1 ];then
			echo $1
		fi
	fi
}

