# Libera espaço em disco
function purge()
{
	echoDebug "...purge"

	rm -f /tmp/alitem-* 2>/dev/null
	rm -f /tmp/gbrowser-* 2>/dev/null
	echo > /var/log/gbrowser.log 2>/dev/null
	echo > /var/log/gjuridico_atualizacoes.log 2>/dev/null
