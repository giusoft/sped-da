data {
  2000 =  10
  2001 =  50
  2002 = -10
  2003 =   0
  2004 = 100
}

graph {
  padding-left   = 40
  padding-top    = 40
  padding-right  = 20
  padding-bottom = 20
  border-width = 0
  area-height = 250
  area-width = 350
  title = 3D Bar Graph
  transparency = 70
  title-font = 5
}

axis {
  y-step = 10
}

scale {
  y-round = 0
}
